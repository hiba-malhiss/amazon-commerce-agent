# Copy to .env and fill in the keys:  cp .env.example .env
# Settings with a default (everything below "Optional") can be left out.

# --- Required ------------------------------------------------------------------

# OpenAI: Understanding (structured output) and the reply
OPENAI_API_KEY=sk-...

# SearchAPI.io: Amazon search and product details (https://www.searchapi.io)
SEARCHAPI_API_KEY=

# Postgres from docker-compose.yml (docker compose up -d)
# LangGraph checkpointer (psycopg)
DATABASE_URL=postgresql://agent:agent_dev_password@localhost:5432/amazon_commerce_agent
# SQLAlchemy + Alembic (same database, psycopg 3 driver)
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://agent:agent_dev_password@localhost:5432/amazon_commerce_agent

# --- Optional: LLM ---------------------------------------------------------------

LLM_MODEL=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS=1600
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Optional: context and token budgets ----------------------------------------

# Conversation history sent to Understanding and the reply
MAX_HISTORY_MESSAGES=8
MAX_HISTORY_TOKENS=2500
# Recent requests kept for follow-ups (their found products are kept with them)
MAX_RECENT_REQUESTS=8
# Lists of shown items kept for references ("the second one", "the Sony one")
MAX_VISIBLE_ENTITY_LISTS=3
# Results shown as numbered cards under one reply
MAX_CARDS_PER_REPLY=10
# Input budgets: must fit the largest prompt (see app/core/settings.py)
MAX_UNDERSTANDING_INPUT_TOKENS=16000
MAX_RESPONSE_INPUT_TOKENS=12000

# --- Optional: limits ------------------------------------------------------------

MAX_REQUESTS_PER_TURN=5
MAX_PARALLEL_TOOLS=3
MAX_USER_MESSAGE_LENGTH=4000
